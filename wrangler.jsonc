{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rainbowhousestudents",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "secrets": {
    "required": ["SESSION_SECRET", "ADMIN_BOOTSTRAP_PASSWORD", "RESEND_API_KEY"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rainbow-house-students-db",
      "database_id": "9797387c-888e-4822-9ee2-9b59e0c52667",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "EMAIL_FROM": "Rainbow House Portal <onboarding@resend.dev>"
  }
}
